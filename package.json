{
  "name": "@nexus-v2/root",
  "version": "0.0.0",
  "private": true,
  "description": "Nexus v2 Phase 0 Engineering Harness",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x",
    "pnpm": "11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "architecture:check": "node architecture/check.mjs",
    "architecture:test": "node --test architecture/checker.test.mjs",
    "build": "pnpm exec tsc -p tsconfig.json --pretty false && pnpm --recursive --if-present build",
    "database:governance": "node scripts/check-database-governance.mjs",
    "db:check": "pnpm database:governance && pnpm --filter @nexus-v2/database db:check",
    "db:generate": "pnpm --filter @nexus-v2/database db:generate",
    "db:local:up": "node scripts/local-infra.mjs postgres-up",
    "db:migrate": "pnpm --filter @nexus-v2/database db:migrate",
    "db:rebuild": "pnpm --filter @nexus-v2/database db:rebuild",
    "db:status": "pnpm --filter @nexus-v2/database db:status",
    "db:test:integration": "pnpm --filter @nexus-v2/database db:test:integration",
    "dev:web": "pnpm --filter @nexus-v2/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:test": "pnpm --filter @nexus-v2/testing fixtures:test",
    "fixtures:test:integration": "pnpm --filter @nexus-v2/testing fixtures:test:integration",
    "infra:down": "node scripts/local-infra.mjs down",
    "infra:health": "node scripts/local-infra.mjs health",
    "infra:logs": "node scripts/local-infra.mjs logs",
    "infra:reset": "node scripts/local-infra.mjs reset",
    "infra:up": "node scripts/local-infra.mjs up",
    "lint": "node -e \"console.log('Linting is scaffolded; implementation begins in a later Phase 0 packet.')\"",
    "preview:web": "pnpm --filter @nexus-v2/web preview",
    "start:api": "pnpm --filter @nexus-v2/api start",
    "start:worker": "pnpm --filter @nexus-v2/worker start",
    "test": "node -e \"console.log('Tests are scaffolded; implementation begins in a later Phase 0 packet.')\"",
    "typecheck": "pnpm exec tsc -p tsconfig.json --pretty false && pnpm --recursive --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm fixtures:test && pnpm architecture:test && pnpm architecture:check && pnpm database:governance && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
